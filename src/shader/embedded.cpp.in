#include <atomic>
#include "shader/embedded.h"

#include <algorithm>
#include <map>
#include <mutex>
#include <string>
#include <vector>

#include <spdlog/spdlog.h>

#include "shader/dxc.h"
#include "shader/spirv.h"

@RVK_HLSL_INCLUDES@
namespace rvk::shader::embedded {
namespace {

const SourceFile kHlsl[] = {
@RVK_HLSL_TABLE@    {{}, {}}};

// compiled HLSL shaders: node-based, so the spans handed out stay valid
struct Compiled {
    std::vector<std::uint32_t> words;
};
std::mutex g_compiledMutex;
std::map<std::string, Compiled, std::less<>> g_compiled;
struct CompiledDxil {
    std::vector<std::uint8_t> bytes;
};
std::map<std::string, CompiledDxil, std::less<>> g_compiledDxil;

bool hlslProfile(std::string_view name, std::string& entry, std::string& profile) {
    const auto dot = name.rfind('.');
    const std::string_view ext = dot == std::string_view::npos ? std::string_view{} : name.substr(dot);
    if (ext == ".comp") { entry = "CSMain"; profile = "cs_6_6"; return true; }
    if (ext == ".vert") { entry = "VSMain"; profile = "vs_6_6"; return true; }
    if (ext == ".frag") { entry = "PSMain"; profile = "ps_6_6"; return true; }
    return false;
}

}  // namespace

std::span<const SourceFile> hlslSources() { return std::span<const SourceFile>(kHlsl).first(std::size(kHlsl) - 1); }

std::string_view hlslSource(std::string_view name) {
    for (const SourceFile& f : hlslSources()) {
        if (f.name == name) return f.text;
    }
    return {};
}

// the request of the embedded shader `name` with "NAME=VALUE;NAME2=VALUE2" defines (false: unknown name / no stage extension)
static bool makeRequest(std::string_view name, std::string_view defines, dxc::Request& request) {
    const std::string hlslName = std::string(name) + ".hlsl";
    if (hlslSource(hlslName).empty()) return false;
    request.file = hlslName;
    request.debugInfo = debugInfo();
    if (!hlslProfile(name, request.entry, request.profile)) {
        spdlog::error("shader {}: no HLSL stage for this extension", name);
        return false;
    }
    for (std::size_t pos = 0; pos < defines.size();) {
        const auto end = std::min(defines.find(';', pos), defines.size());
        const std::string_view d = defines.substr(pos, end - pos);
        if (!d.empty()) {
            const auto eq = d.find('=');
            request.defines.push_back({std::string(d.substr(0, eq)), eq == std::string_view::npos ? std::string() : std::string(d.substr(eq + 1))});
        }
        pos = end + 1;
    }
    return true;
}

std::span<const std::uint32_t> spirvVariant(std::string_view name, std::string_view defines) {
    const std::string key = std::string(name) + "?" + std::string(defines) + (debugInfo() ? "?debug" : "");
    const std::lock_guard lock(g_compiledMutex);  // (compiles serialize: the disk cache makes them rare)
    if (auto it = g_compiled.find(key); it != g_compiled.end()) return it->second.words;
    dxc::Request request;
    if (!makeRequest(name, defines, request)) return {};
    dxc::Result r = dxc::compile(request);
    if (!r.ok()) {
        spdlog::error("shader {} [{}]: HLSL compile failed: {}", name, defines, r.log);
        return {};
    }
    if (!r.log.empty()) spdlog::debug("shader {}: {}", name, r.log);
    return g_compiled.emplace(key, Compiled{std::move(r.words)}).first->second.words;
}

std::span<const std::uint8_t> dxilVariant(std::string_view name, std::string_view defines) {
    const std::string key = std::string(name) + "?" + std::string(defines) + (debugInfo() ? "?debug" : "");
    const std::lock_guard lock(g_compiledMutex);
    if (auto it = g_compiledDxil.find(key); it != g_compiledDxil.end()) return it->second.bytes;
    dxc::Request request;
    if (!makeRequest(name, defines, request)) return {};
    request.target = dxc::Target::Dxil;
    dxc::Result r = dxc::compile(request);
    if (!r.ok()) {
        spdlog::error("shader {} [{}]: HLSL compile to DXIL failed: {}", name, defines, r.log);
        return {};
    }
    if (!r.dxilSigned) spdlog::warn("shader {} [{}]: the DXIL is not signed (dxil.dll next to dxcompiler.dll?)", name, defines);
    return g_compiledDxil.emplace(key, CompiledDxil{std::move(r.bytes)}).first->second.bytes;
}

std::span<const std::uint32_t> spirv(std::string_view name) { return spirvVariant(name, {}); }
std::span<const std::uint8_t> dxil(std::string_view name) { return dxilVariant(name, {}); }

static std::atomic<bool> g_dxilWanted{false};
void setDxilWanted(bool wanted) { g_dxilWanted.store(wanted); }
std::span<const std::uint8_t> dxilOnDemand(std::string_view name) { return g_dxilWanted.load() ? dxil(name) : std::span<const std::uint8_t>{}; }
std::span<const std::uint8_t> dxilVariantOnDemand(std::string_view name, std::string_view defines) {
    return g_dxilWanted.load() ? dxilVariant(name, defines) : std::span<const std::uint8_t>{};
}

}  // namespace rvk::shader::embedded
