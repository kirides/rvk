#version 460
// RT scene debug view, compute part (setting rt.debug, src/enh/rt_debug.cpp): one camera ray per back-buffer pixel against
// the frame's TLAS (FrameBlock rtScene), written as a colour + coverage into a transient image that the composite blends
// over the post-processed frame (BeforeGui: the colours are not tone-mapped).
//   instances: a colour per instance (stable registry id), alpha-tested instances striped, instances only the sun
//              cascades saw white-checkered; dark blue = the raster has geometry where the ray missed
//   depth:     the traced hit distance against the raster's (the hardware depth captured at AfterOpaque, else the
//              engine's linear depth map, which has only the z-pass subset of the opaque draws): green = match, red = the ray hit farther (geometry the
//              raster has and the TLAS lacks: foliage, characters, ...), magenta = the ray hit closer (TLAS geometry the
//              raster does not show there: a wrong transform / index range would show up so; cyan when the engine drew
//              that object without depth writes or with a depth bias, so the depth buffer cannot show it exactly), blue =
//              the ray missed
//   normals:   the interpolated vertex normal from the geometry records (vertex fetch by device address), magenta where the
//              fetched triangle's position disagrees with the hit (a wrong record)
//   albedo:    the hit's diffuse texture (the material's uv map, ray-cone mip; M9 P2), unlit, times a fixed N.L for shape;
//              hits without a diffuse texture in a grey checker; with RT_DEBUG_SPLIT the right half of the picture only
//   uv:        fract of the hit's diffuse coordinate (red = u, green = v), blue where the map is approximate
// Alpha-tested instances are resolved with their alpha test in the candidate loop (rvk_rt_trace.glsl) unless RT_DEBUG_OPAQUE.
#extension GL_EXT_ray_query : require

#include "rt_debug.glsl"
#include "rvk_rt_trace.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D outColor;

uint hashU(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

vec3 hue(float h) { return clamp(abs(fract(h + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0); }

// the probe index of pixel p (a 5 x 5 grid; picture rows 15 % .. 85 %: inside the letterbox), or -1
int probeIndex(uvec2 p) {
    uint i = uint((float(p.x) + 0.5) * 5.0 / float(pc.width));
    float fy = ((float(p.y) + 0.5) / float(pc.height) - 0.15) / 0.7;
    if (fy < 0.0 || fy >= 1.0) return -1;
    uint j = uint(fy * 5.0);
    uint px = uint((float(i) + 0.5) * float(pc.width) / 5.0);
    uint py = uint((0.15 + (float(j) + 0.5) / 5.0 * 0.7) * float(pc.height));
    return (p.x == px && p.y == py && i < 5u && j < 5u) ? int(j * 5u + i) : -1;
}

void probe(uvec2 p, uint record, float t, float rasterT, uint code) {
    if (pc.probes == uvec2(0u)) return;
    int k = probeIndex(p);
    if (k >= 0) RtDebugProbes(pc.probes).p[k] = RtDebugProbe(record, t, rasterT, code);
}

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.width || p.y >= pc.height) return;
    RvkFrame f = pc.frame;
    vec4 result = vec4(0.0);
    if (!rvkRtValid(f) || (f.frameInfo.y & RVK_FRAME_CAMERA_VALID) == 0u) {
        imageStore(outColor, ivec2(p), result);
        return;
    }
    vec2 uv = (vec2(p) + 0.5) / vec2(pc.width, pc.height);
    vec4 farPoint = f.invViewProj * vec4(rvkUvToNdc(uv), 1.0, 1.0);
    vec3 farPos = farPoint.xyz / farPoint.w;
    vec3 origin = f.cameraPos.xyz;
    vec3 dir = farPos - origin;
    float farLen = length(dir);
    dir /= max(farLen, 1e-6);

    // the raster's distance along this ray from the engine's linear depth map (cleared to 1 = nothing)
    bool raster = false;
    float rasterT = 0.0;
    if (pc.depthTex != 0u) {
        ivec2 dsize = rvkSize2D(pc.depthTex);
        float d = rvkFetch2D(pc.depthTex, clamp(ivec2(uv * vec2(dsize)), ivec2(0), dsize - 1)).r;
        // the hardware depth capture holds view depth (0 = nothing), the engine's depth map view depth / far (1 = nothing)
        bool linear = (pc.mode & RT_DEBUG_LINEAR_DEPTH) != 0u;
        float viewDepth = linear ? d : (d < 0.9999 ? rvkViewDepth(f, d) : 0.0);
        if (viewDepth > 0.0) {
            raster = true;
            rasterT = farLen * viewDepth / max(f.depthParams.y, 1e-3);
        }
    }
    uint mode = pc.mode & 0xFFu;
    // which raster depth the depth check uses: a square at the top left, white = the hardware depth capture, grey = the
    // engine's linear depth map (z-pass draws only)
    if (mode == RT_DEBUG_DEPTH && p.x < 12u && p.y < 12u) {
        imageStore(outColor, ivec2(p), (pc.mode & RT_DEBUG_LINEAR_DEPTH) != 0u ? vec4(1.0) : vec4(0.4, 0.4, 0.4, 1.0));
        return;
    }

    // albedo / uv split view: the left half shows the raster
    bool material = mode == RT_DEBUG_ALBEDO || mode == RT_DEBUG_UV;
    if (material && (pc.mode & RT_DEBUG_SPLIT) != 0u && p.x < pc.width / 2u) {
        imageStore(outColor, ivec2(p), p.x + 1u >= pc.width / 2u ? vec4(1.0, 1.0, 0.0, 1.0) : vec4(0.0));
        return;
    }

    float tMin = max(f.depthParams.x * 0.5, 1.0);
    // the pixel's cone: its angle (vertical field of view over the height)
    float coneSpread = 2.0 / (max(abs(f.proj[1][1]), 1e-3) * float(pc.height));
    RvkRtHit h = rvkRtTraceClosest(f, origin, dir, tMin, 1.0e7, 0.0, coneSpread, (pc.mode & RT_DEBUG_OPAQUE) != 0u ? RVK_RT_TRACE_OPAQUE : 0u);
    bool hit = h.hit;

    if (!hit) {
        if (material) result = raster ? vec4(0.1, 0.05, 0.3, 1.0) : vec4(0.25, 0.45, 0.75, 1.0);  // geometry the RT scene lacks / sky
        else if (raster) result = vec4(0.05, 0.15, 0.9, 0.55);
        probe(p, 0u, 0.0, rasterT, raster ? 4u : 0u);
        imageStore(outColor, ivec2(p), result);
        return;
    }
    float t = h.t;
    uint index = h.record;
    RvkRtRecord rec = rvkRtRecord(f, index);
    {
        float tol = max(4.0, rasterT * 0.004);
        probe(p, index + 1u, t, rasterT, !raster ? 5u : abs(t - rasterT) <= tol ? 1u : t > rasterT ? 2u : 3u);
    }
    if (mode == RT_DEBUG_INSTANCES) {
        vec3 c = hue(float(hashU(rec.instanceId) & 0xFFFFu) / 65536.0) * 0.85 + 0.15;
        if ((rec.flags & RVK_RT_ALPHA_TESTED) != 0u && ((p.x + p.y) & 4u) != 0u) c *= 0.35;  // alpha-tested: stripes
        if ((rec.flags & RVK_RT_VIEW_MAIN) == 0u && ((p.x ^ p.y) & 4u) != 0u) c = vec3(1.0, 1.0, 1.0);  // only the cascades saw it: checker
        result = vec4(c, 0.6);
    } else if (mode == RT_DEBUG_DEPTH) {
        if (!raster) {
            result = vec4(1.0, 0.0, 1.0, 0.75);  // the ray hit, the raster shows sky
        } else {
            float diff = t - rasterT;
            float tol = max(4.0, rasterT * 0.004);
            if (abs(diff) <= tol) {
                result = vec4(0.1, 0.9, 0.2, 0.5);
            } else if (diff < 0.0 && (rec.flags & (RVK_RT_NO_DEPTH_WRITE | RVK_RT_DEPTH_BIAS)) != 0u) {
                result = vec4(0.0, 0.9, 0.9, 0.75);  // closer, but the raster drew it without depth writes / with a depth bias: cyan
            } else {
                float k = clamp((abs(diff) - tol) / max(4.0 * tol, 50.0), 0.0, 1.0);
                result = diff > 0.0 ? vec4(mix(vec3(1.0, 0.8, 0.1), vec3(1.0, 0.05, 0.05), k), 0.75)    // farther: missing in the TLAS
                                    : vec4(mix(vec3(0.8, 0.4, 1.0), vec3(1.0, 0.0, 1.0), k), 0.75);     // closer: extra / wrong
            }
        }
    } else if (mode == RT_DEBUG_NORMALS) {
        RvkRtSurface s = rvkRtSurface(rec, h.primitive, h.bary);
        vec3 world = rvkRtWorldPosition(h.objectToWorld, s.position);
        float err = distance(world, origin + dir * t);
        vec3 n = dot(s.normal, s.normal) > 1e-12 ? s.normal : s.geometricNormal;
        n = rvkRtWorldNormal(h.worldToObject, n);
        result = err > max(2.0, t * 0.002) ? vec4(1.0, 0.0, 1.0, 0.9) : vec4(n * 0.5 + 0.5, 0.85);
    } else {
        RvkRtHitSurface s = rvkRtHitSurface(f, h, dir, 0.0, coneSpread);
        if (mode == RT_DEBUG_UV) {
            result = vec4(fract(s.uv), (s.uvSet & RVK_RT_UV_APPROX) != 0u ? 0.8 : 0.0, 1.0);
        } else {
            // a fixed light from above-front so shapes read; the texture itself unlit
            float nl = 0.55 + 0.45 * clamp(dot(s.normal, normalize(vec3(0.3, 0.8, -0.5))), 0.0, 1.0);
            vec3 c = s.albedo.rgb * nl;
            if ((s.uvSet & RVK_RT_UV_NO_TEXTURE) != 0u && ((p.x ^ p.y) & 8u) != 0u) c *= 0.6;  // no diffuse texture: checker
            result = vec4(c, 1.0);
        }
    }
    imageStore(outColor, ivec2(p), result);
}
