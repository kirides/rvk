// S-7d (docs/research/frame-ownership.md 14.18): the shared helpers of the effect ports in shaders/post/fx (generated by tools/post_port.py). The ports are the
// engine's fx_2_0 effect shaders (post_SSM.fx: shadow mask, SSAO chain, PSSM; post_blur7 (the terrain map's blur); post_hdr / post_dof / post_bloom /
// post_streaks / overlay_color / post_radialBlur / post_wobble / post_edgesmooth) written against this ABI instruction for instruction, with the D3D9
// arithmetic rules of the translator (src/shader/hlsl.cpp: rcp / rsq clamped to FLT_MAX, log(0) = -FLT_MAX, pow(x, 0) = 1, nrm(0) = 0, cmp = x >= 0,
// the alpha test / texkill of the draw block), so `native.own_post=compare` measures them EQUAL to the translated shaders.
#pragma once

#include "rvk_draw.hlsli"

float rvkPortPow(float x, float y) { return y == 0.0 ? 1.0 : pow(x, y); }
float4 rvkPortLit(float4 s) {
    float y = max(s.x, 0.0);
    float z = (s.x > 0.0 && s.y > 0.0) ? pow(s.y, clamp(s.w, -128.0, 128.0)) : 0.0;
    return float4(1.0, y, z, 1.0);
}
float4 rvkPortNrm(float4 s) {
    float l = dot(s.xyz, s.xyz);
    return l > 0.0 ? s * rsqrt(l) : float4(0.0, 0.0, 0.0, 0.0);
}
// relative constant addressing (c[a0 + n]): out of range = 0
float4 rvkPortPsRel(int i) { return uint(i) < 224u ? RVK_PSC(i) : float4(0.0, 0.0, 0.0, 0.0); }
float4 rvkPortVsRel(int i) { return uint(i) < 256u ? RVK_VSC(i) : float4(0.0, 0.0, 0.0, 0.0); }

// the draw block's alpha test and texkill (abi.h DrawBlock alpha: x flags | function, y reference; the hashed cut-out of jittered draws)
float rvkPortAlphaNoise(RvkDrawData d, float4 fragCoord) {
    float2 p = fragCoord.xy + 5.588238 * float((d.alpha.x >> 16u) & 63u);
    return frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715))));
}
bool rvkPortKill(RvkDrawData d, float4 fragCoord, float x) {
    float w = max(fwidth(x), 1.0 / 255.0);
    uint f = d.alpha.x;
    if ((f & 0x400u) != 0u) x += float(f >> 24u) * (1.0 / 255.0) * min(w, 1.0);
    if ((f & 0x100u) == 0u) return x < 0.0;
    return clamp(x / w + 0.5, 0.0, 1.0) <= rvkPortAlphaNoise(d, fragCoord);
}
bool rvkPortAlphaTest(RvkDrawData d, float4 fragCoord, float a) {
    float q = round(clamp(a, 0.0, 1.0) * 255.0);
    float r = asfloat(d.alpha.y);
    uint f = d.alpha.x & 0xffu;
    if ((f == 5u || f == 7u) && (d.alpha.x & 0x500u) != 0u) {
        return !rvkPortKill(d, fragCoord, a - (f == 5u ? r + 0.5 : r - 0.5) / 255.0);
    }
    switch (f) {
    case 1u: return false;
    case 2u: return q < r;
    case 3u: return q == r;
    case 4u: return q <= r;
    case 5u: return q > r;
    case 6u: return q != r;
    case 7u: return q >= r;
    default: return true;
    }
}
