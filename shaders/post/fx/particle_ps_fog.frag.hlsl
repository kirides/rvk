// own particles (docs/research/frame-ownership.md 14.28, particle ports): pixel shader of the particles (ge_particle_2_0.fx, shader pool), our port (generated by tools/post_port.py; do not edit by hand, regenerate).
// Used by: ge_particle_2_0.fx PS, one texture, fog (+0x300).
// Registers / samplers (the engine's constant table): c3 g_FogColor; s9 g_SamplerData.
#include "post_port.hlsli"

struct RvkPsIn {
    float4 rvk_fragCoord : SV_Position;
    [[vk::location(0)]] float4 t0 : VARY0;
    [[vk::location(1)]] float4 rvk_fill1 : VARY1;
    [[vk::location(2)]] float4 rvk_fill2 : VARY2;
    [[vk::location(3)]] float4 rvk_fill3 : VARY3;
    [[vk::location(4)]] float4 t4 : VARY4;
    [[vk::location(5)]] float4 rvk_fill5 : VARY5;
    [[vk::location(6)]] float4 t6 : VARY6;
};
struct RvkPsOut {
    float4 oC0 : SV_Target0;
};

RvkPsOut PSMain(RvkPsIn rvk_in) {
    const RvkDrawData rvk_draw = rvkLoadDraw();
    float4 rvk_fragCoord = (float4)0;
    float4 t0 = (float4)0;
    float4 t4 = (float4)0;
    float4 t6 = (float4)0;
    float4 oC0 = float4(0.0, 0.0, 0.0, 0.0);
    float4 r0 = float4(0.0, 0.0, 0.0, 0.0);
    float4 r1 = float4(0.0, 0.0, 0.0, 0.0);
    RvkPsOut rvk_out = (RvkPsOut)0;
    rvk_fragCoord = rvk_in.rvk_fragCoord;
    t0 = rvk_in.t0;
    t4 = rvk_in.t4;
    t6 = rvk_in.t6;
    // ---- the program
    r0 = RVK_TEX2D_UNI(rvk_draw.tex[2][1]).Sample(RVK_SAMP_UNI(rvk_draw.smp[2][1]), t0.xy);
    r1.xyz = (t6 * (-r0) + RVK_PSC(3)).xyz;
    r0 = r0 * t6;
    r0.xyz = (t4.xxxx * r1 + r0).xyz;
    oC0 = r0;
    // ---- outputs
    if (!rvkPortAlphaTest(rvk_draw, rvk_fragCoord, oC0.a)) discard;
    rvk_out.oC0 = oC0;
    return rvk_out;
}
