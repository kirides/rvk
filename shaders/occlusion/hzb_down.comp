#version 460
// One level of the max-depth pyramid (src/enh/occlusion.cpp): each texel = the farthest depth of a 2x2 block of the level
// above (level 0 reads the engine's linear depth map, 1 = cleared / sky). A sphere is hidden when its nearest depth is behind
// the farthest depth of the pixels it covers.

#define RVK_PASS_SHADER 1
#include "rvk_abi.glsl"
#include "rvk_common.glsl"

layout(push_constant, std430) uniform HzbPush {
    RVK_PASS_PUSH_HEADER
    uint srcTex;  // bindless t2D of the level above (level 0: the depth map)
    uint srcW;
    uint srcH;
    uint dstW;
    uint dstH;
    uint pad0;
    uint pad1;
    uint pad2;
} pc;

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0, r32f) uniform writeonly image2D outLevel;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.dstW) || p.y >= int(pc.dstH)) return;
    ivec2 s = p * 2;
    ivec2 m = ivec2(int(pc.srcW) - 1, int(pc.srcH) - 1);
    float d = rvkFetch2D(pc.srcTex, min(s, m)).r;
    d = max(d, rvkFetch2D(pc.srcTex, min(s + ivec2(1, 0), m)).r);
    d = max(d, rvkFetch2D(pc.srcTex, min(s + ivec2(0, 1), m)).r);
    d = max(d, rvkFetch2D(pc.srcTex, min(s + ivec2(1, 1), m)).r);
    imageStore(outLevel, p, vec4(d, 0.0, 0.0, 0.0));
}
