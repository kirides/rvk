#version 460
// Screen probe resolve (M10 stage C P8, src/enh/gi.cpp, docs/research/rtgi.md 11): per pixel the 2 x 2 nearest tile probes,
// weighted bilinearly x depth x normal similarity (the probes' own pixels in the G-buffer), then temporal accumulation with
// the previous frame's result at the motion-reprojected position, clamped to the probes' range. rgb = the GI ratio the
// material shaders of this frame read at their own pixel, a = the pixel's view depth (0 = no probe covered it): a draw whose
// depth differs (not in the z pre-pass: characters, alpha) leaves it alone. Normals and motion from the depth (after the z
// pre-pass, before the G-buffer).

#define RVK_PASS_SHADER 1
#include "rvk_abi.glsl"
#include "rvk_common.glsl"
#include "rvk_gi.glsl"
#include "gi_common.glsl"
#include "screen_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D outResolved;

void main() {
    GiPassParams p = GiPassParams(pc.params);
    RvkFrame f = pc.frame;
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sizeI = ivec2(p.screen2.zw);
    if (px.x >= sizeI.x || px.y >= sizeI.y) return;
    vec2 size = vec2(sizeI);
    float zpx = rvkHwDepthToD3D(f, rvkFetch2D(p.screen.x, px).r);
    float viewZ = spViewDepth(f, zpx);
    if (viewZ <= 0.0) {
        imageStore(outResolved, px, vec4(1.0, 1.0, 1.0, 0.0));
        return;
    }
    vec3 N = spDepthNormal(f, px, size, p.screen.x);
    vec3 P = spWorldPos(f, px, size, zpx);
    float tsize = float(max(p.screen2.x, 1u));
    ivec2 grid = ivec2(p.screen.zw);
    ivec2 centre = clamp(ivec2((vec2(px) + 0.5) / tsize), ivec2(0), grid - 1);
    float sum = 0.0, lo = 1e9, hi = -1e9;
    float wsum = 0.0;
    // the chroma ratio (colour bleeding): a wider Gaussian (sigma two tiles) over the same 3 x 3 probes, a longer history
    vec2 csum = vec2(0.0);
    float cwsum = 0.0;
    const vec3 lw = vec3(0.2126, 0.7152, 0.0722);
    // the 3 x 3 probes around the pixel's tile: a Gaussian of the distance to each tile's centre (sigma = one tile) x the
    // surface weights (a spatial filter over 9 probes: less grain than the bilinear 2 x 2)
    for (int i = 0; i < 9; ++i) {
        ivec2 tile = clamp(centre + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), grid - 1);
        vec4 pr = rvkFetch2D(p.screen3.x, tile);
        if (pr.a <= 0.0) continue;
        // the distance to the tile's centre (stable from frame to frame; the probe's own pixel is jittered per frame: as the
        // weight it made the filter flicker, measured)
        vec2 dpx = ((vec2(tile) + 0.5) * tsize - (vec2(px) + 0.5)) / tsize;
        float w = exp(-0.5 * dot(dpx, dpx)) + 1e-3;
        float wc = exp(-0.125 * dot(dpx, dpx)) + 1e-3;
        // the probe's distance to this pixel's tangent plane (slanted surfaces keep their neighbours) and normal similarity
        ivec2 ppx = spProbePixel(p, tile);
        vec3 pp = spWorldPos(f, ppx, size, rvkHwDepthToD3D(f, rvkFetch2D(p.screen.x, ppx).r));
        float plane = abs(dot(pp - P, N));
        vec3 pn = spDepthNormal(f, ppx, size, p.screen.x);
        float surf = exp(-plane / max(viewZ * 0.01, 2.0)) * pow(max(dot(pn, N), 0.0), 4.0);
        w *= surf;
        sum += pr.r * w;
        wsum += w;
        csum += pr.gb * (wc * surf);
        cwsum += wc * surf;
        lo = min(lo, pr.r);
        hi = max(hi, pr.r);
    }
    vec3 chroma = vec3(1.0);
    if (cwsum > 1e-4) {
        vec2 c = csum / cwsum;
        chroma = vec3(c.x, (1.0 - lw.r * c.x - lw.b * c.y) / lw.g, c.y);
    }
    vec4 result = vec4(1.0, 1.0, 1.0, 0.0);
    bool covered = wsum > 1e-4;
    if (covered) result = vec4(vec3(sum / wsum) * chroma, viewZ);
    // temporal accumulation: the luminance ratio at p.screen4.z, the chroma ratio at a longer history (colour noise is the
    // visible kind); the history's luminance is its ratio, its colour / luminance the chroma (the probes' chroma has unit luminance)
    if (p.screen3.y != 0u) {
        vec2 uv = (vec2(px) + 0.5) / size;
        vec2 prev = uv + spCameraMotion(f, P);
        if (all(greaterThanEqual(prev, vec2(0.0))) && all(lessThanEqual(prev, vec2(1.0)))) {
            vec4 h = rvkSample2DLod(p.screen3.y, p.screen3.w, prev, 0.0);
            if (h.a > 0.0) {
                float hl = dot(h.rgb, lw);
                vec3 hchroma = hl > 1e-3 ? clamp(h.rgb / hl, vec3(0.6), vec3(1.6)) : vec3(1.0);
                if (covered) {
                    float hk = clamp(hl, lo - 0.25, hi + 0.25);
                    float k = mix(sum / wsum, hk, p.screen4.z);
                    vec3 c = mix(chroma, hchroma, 1.0 - (1.0 - p.screen4.z) * 0.3);
                    result.rgb = vec3(k) * c;
                } else {
                    result = vec4(h.rgb, viewZ);
                }
            }
        }
    }
    imageStore(outResolved, px, result);
}
