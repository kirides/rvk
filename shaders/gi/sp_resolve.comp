#version 460
// Screen probe resolve (M10 stage C P8, src/enh/gi.cpp, docs/research/rtgi.md 11): per pixel the 2 x 2 nearest tile probes,
// weighted bilinearly x depth x normal similarity (the probes' own pixels in the G-buffer), then temporal accumulation with
// the previous frame's result at the motion-reprojected position, clamped to the probes' range. rgb = the GI ratio the
// material shaders apply next frame (reprojected), a = 1 where probes covered the pixel.

#define RVK_PASS_SHADER 1
#include "rvk_abi.glsl"
#include "rvk_common.glsl"
#include "rvk_gi.glsl"
#include "gi_common.glsl"
#include "screen_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D outResolved;

void main() {
    GiPassParams p = GiPassParams(pc.params);
    RvkFrame f = pc.frame;
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sizeI = ivec2(p.screen2.zw);
    if (px.x >= sizeI.x || px.y >= sizeI.y) return;
    vec2 size = vec2(sizeI);
    float viewZ = spViewDepth(f, rvkFetch2D(p.screen.x, px).r);
    vec4 g = rvkFetch2D(p.screen.y, px);
    if (viewZ <= 0.0 || g.w < 0.16) {
        imageStore(outResolved, px, vec4(1.0, 1.0, 1.0, 0.0));
        return;
    }
    vec3 N = rvkGiOctDecode(g.xy);
    vec3 P = spWorldPos(f, px, size, rvkFetch2D(p.screen.x, px).r);
    float tsize = float(max(p.screen2.x, 1u));
    ivec2 grid = ivec2(p.screen.zw);
    ivec2 centre = clamp(ivec2((vec2(px) + 0.5) / tsize), ivec2(0), grid - 1);
    vec3 sum = vec3(0.0), lo = vec3(1e9), hi = vec3(-1e9);
    float wsum = 0.0;
    // the 3 x 3 probes around the pixel's tile: a Gaussian of the distance to each tile's centre (sigma = one tile) x the
    // surface weights (a spatial filter over 9 probes: less grain than the bilinear 2 x 2)
    for (int i = 0; i < 9; ++i) {
        ivec2 tile = clamp(centre + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), grid - 1);
        vec4 pr = rvkFetch2D(p.screen3.x, tile);
        if (pr.a <= 0.0) continue;
        // the distance to the tile's centre (stable from frame to frame; the probe's own pixel is jittered per frame: as the
        // weight it made the filter flicker, measured)
        vec2 dpx = ((vec2(tile) + 0.5) * tsize - (vec2(px) + 0.5)) / tsize;
        float w = exp(-0.5 * dot(dpx, dpx)) + 1e-3;
        // the probe's distance to this pixel's tangent plane (slanted surfaces keep their neighbours) and normal similarity
        ivec2 ppx = spProbePixel(p, tile);
        vec3 pp = spWorldPos(f, ppx, size, rvkFetch2D(p.screen.x, ppx).r);
        float plane = abs(dot(pp - P, N));
        w *= exp(-plane / max(viewZ * 0.01, 2.0));
        vec3 pn = rvkGiOctDecode(rvkFetch2D(p.screen.y, ppx).xy);
        w *= pow(max(dot(pn, N), 0.0), 4.0);
        sum += pr.rgb * w;
        wsum += w;
        lo = min(lo, pr.rgb);
        hi = max(hi, pr.rgb);
    }
    vec4 result = vec4(1.0, 1.0, 1.0, 0.0);
    if (wsum > 1e-4) result = vec4(sum / wsum, 1.0);
    // temporal accumulation
    if (p.screen3.y != 0u) {
        vec2 uv = (vec2(px) + 0.5) / size;
        vec2 prev = uv + rvkFetch2D(p.screen3.z, px).xy;
        if (all(greaterThanEqual(prev, vec2(0.0))) && all(lessThanEqual(prev, vec2(1.0)))) {
            vec4 h = rvkSample2DLod(p.screen3.y, p.screen3.w, prev, 0.0);
            if (h.a > 0.5) {
                if (result.a > 0.5) {
                    vec3 hc = clamp(h.rgb, lo - 0.25, hi + 0.25);
                    result.rgb = mix(result.rgb, hc, p.screen4.z);
                } else {
                    result = vec4(h.rgb, 1.0);
                }
            }
        }
    }
    imageStore(outResolved, px, result);
}
