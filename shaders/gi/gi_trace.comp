#version 460
// GI probe rays (M10 stage A, src/enh/gi.cpp, docs/research/rtgi.md 5, 9): one workgroup per probe of this frame's update
// list, one ray per invocation (64 spherical-Fibonacci directions, randomly rotated each frame) against the frame's TLAS,
// shaded by gi_shade.glsl (engine-style lighting at hits, the sky on misses, back faces marked). gi_blend.comp then folds the
// rays into the probe.
#extension GL_EXT_ray_query : require

#define RVK_PASS_SHADER 1
#include "rvk_abi.glsl"
#include "rvk_common.glsl"
#include "rvk_rt_trace.glsl"
#include "rvk_gi.glsl"
#include "gi_common.glsl"
#include "gi_shade.glsl"

layout(local_size_x = 64) in;

shared uint sVis[4];

void main() {
    GiPassParams p = GiPassParams(pc.params);
    RvkFrame f = pc.frame;
    uint item = gl_WorkGroupID.x;
    if (item >= p.volume.z) return;
    uint ray = gl_LocalInvocationID.x;
    RvkGiVolume v = RvkGiVolume(p.volume.xy);
    uint e = GiList(p.lists.xy).e[item];
    uint c = e >> 24;
    uint slot = e & 0xFFFFFFu;
    ivec3 dims = ivec3(v.dims.xyz);
    ivec3 cell = rvkGiCellOfSlot(dims, v.cascade[c].origin.xyz, slot);
    vec3 P = vec3(cell) * v.cascade[c].spacing.x;
    // the point-light pick of the hit (giPointLights): stratified over the probe's rays (a golden-ratio sequence from a random
    // per-probe, per-frame start) instead of independent draws: the rays together sample the lights evenly (rtgi.md 20)
    float u = fract(float(ray) * 0.6180339887 + float(giHash(item * 2654435761u + p.volume.w * 7919u) & 0xFFFFFFu) / 16777216.0);
    // the lights this probe sees (their direct light enters the probe in gi_blend.comp: rtgi.md 19): light j by invocation
    // j % 64, one visibility ray each
    if ((p.flags.z & 1u) != 0u) {
        if (ray < 4u) sVis[ray] = 0u;
        barrier();
        uint nL = min(p.flags.y, GI_MAX_LIGHTS);
        for (uint j = ray; j < nL; j += GI_RAYS) {
            vec4 lp = p.lights[j * 2u];
            vec3 d = lp.xyz - P;
            float d2 = dot(d, d);
            if (d2 * lp.w >= 1.0 || dot(p.lights[j * 2u + 1u].rgb, vec3(1.0)) <= 1e-4) continue;
            float dist = sqrt(max(d2, 1e-4));
            if (rvkRtVisibility(f, P, d / dist, 1.0, max(dist - 8.0, 1.0), 0.0, 0.0, RVK_RT_TRACE_OPAQUE) > 0.5) {
                atomicOr(sVis[j >> 5u], 1u << (j & 31u));
            }
        }
        barrier();
        if (ray == 0u) {
            GiRays(p.lists.zw).r[GI_MAX_PROBE_ITEMS * GI_RAYS + item] = uintBitsToFloat(uvec4(sVis[0], sVis[1], sVis[2], sVis[3]));
        }
    }
    GiRays(p.lists.zw).r[item * GI_RAYS + ray] = giShadeRay(p, f, v, P, giRayDir(p, ray), p.reach[c], u);
}
