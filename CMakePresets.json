{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Visual Studio 2026 x64 (vcpkg)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config x64 (vcpkg, run from a VS x64 developer shell)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_HOST_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "profiling",
      "displayName": "Tracy profiling (VS 2026 x64, RVK_TRACY=ON; build/RelWithProfiling, the shipped build/ stays RVK_TRACY=OFF)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/RelWithProfiling",
      "cacheVariables": {
        "RVK_TRACY": "ON"
      }
    },
    {
      "name": "clang-o0",
      "displayName": "clang-cl, no optimization (Ninja, RelWithDebInfo = /Od /Ob0 + debug info; build-clang-o0; run from a VS x64 developer shell)",
      "inherits": "ninja",
      "binaryDir": "${sourceDir}/build-clang-o0",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/Od /Ob0 /DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/Od /Ob0 /DNDEBUG",
        "CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO",
        "CMAKE_MODULE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO"
      }
    },
    {
      "name": "clang-pedantic",
      "displayName": "clang-cl pedantic (Ninja, RelWithDebInfo optimized + RVK_PEDANTIC warnings; build-clang-pedantic; run from a VS x64 developer shell; docs/research/clang-pedantic.md)",
      "inherits": "ninja",
      "binaryDir": "${sourceDir}/build-clang-pedantic",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "RVK_PEDANTIC": "ON",
        "RVK_PCH": "OFF",
        "CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO",
        "CMAKE_MODULE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO"
      }
    },
    {
      "name": "clang-ubsan",
      "displayName": "clang-cl -fsanitize=undefined (Ninja, RelWithDebInfo optimized; build-clang-ubsan; build rvk_tests / rvk_d3d9test only; docs/research/clang-pedantic.md)",
      "inherits": "clang-pedantic",
      "binaryDir": "${sourceDir}/build-clang-ubsan",
      "cacheVariables": {
        "RVK_PEDANTIC": "OFF",
        "RVK_UBSAN": "ON"
      }
    },
    {
      "name": "public-release",
      "displayName": "Public Release (Ninja, RelWithDebInfo linked without /INCREMENTAL, /OPT:REF /OPT:ICF; CI + nightly)",
      "inherits": "ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
        "CMAKE_MODULE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "default", "configuration": "Debug" },
    { "name": "release", "configurePreset": "default", "configuration": "RelWithDebInfo" },
    { "name": "clang-o0", "configurePreset": "clang-o0", "configuration": "RelWithDebInfo" },
    { "name": "clang-pedantic", "configurePreset": "clang-pedantic", "configuration": "RelWithDebInfo" },
    { "name": "clang-ubsan", "configurePreset": "clang-ubsan", "configuration": "RelWithDebInfo" },
    { "name": "public-release", "configurePreset": "public-release", "configuration": "RelWithDebInfo" }
  ]
}
